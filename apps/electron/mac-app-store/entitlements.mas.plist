<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!--
    Entitlements for the top-level DocNinja.app (Mac App Store build).
    Kept to what the app actually uses: App Review asks for a justification of
    every entitlement, and osx-sign's own default adds camera, microphone, USB,
    printing and network access that DocNinja never touches.
    application-groups, com.apple.application-identifier and
    com.apple.developer.team-identifier are injected by @electron/osx-sign
    (preAutoEntitlements) from the signing identity's Team ID.
  -->
  <dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Documents and output folders the user picks in the open dialog / File System Access picker -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!--
      Security-scoped bookmarks of those picked folders, so they stay readable
      after a restart (src/security-scoped-bookmarks.mts)
    -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <!--
      Loopback only: the backend process (src/backend-process.mts) answers each
      window request through a short-lived HTTP server on 127.0.0.1 and
      connects to it with supertest. Without these the sandbox refuses both
      (listen/connect EPERM). Nothing is reachable from or sent to the network.
    -->
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
