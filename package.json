{
  "name": "doc-ninja--monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "purge:workspace--node_modules": "ms-cli purge --target node_modules",
    "purge:workspace--dist": "ms-cli purge --target dist",
    "purge": "ms-cli purge",
    "build:apps": "pnpm --filter \"./packages/**\" --filter \"./apps/**\" build",
    "build:apps--release": "pnpm run build:apps && pnpm --filter \"./apps/be-krang\" run build:python",
    "dev:apps": "pnpm --filter \"./packages/**\" --filter \"./apps/**\" --parallel dev",
    "el:start": "pnpm --filter \"./apps/electron\" start",
    "el:make": "pnpm --filter \"./apps/electron\" make"
  },
  "devDependencies": {
    "@mainset/cli": "^0.6.0",
    "@mainset/dev-stack-fe": "^0.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1"
  },
  "packageManager": "pnpm@11.15.1"
}
