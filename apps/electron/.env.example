# Copy to .env (git-ignored) and fill in. Needed only for the store packages
# (MSIX: Microsoft Store, mas: Mac App Store); `pnpm start` and the other makers run without it.
# Variables set in the shell take precedence over this file.

# Partner Center > Product identity
# Package/Identity/Name
MSIX__PACKAGE_IDENTITY=
# Package/Identity/Publisher, without the leading "CN="
MSIX__PUBLISHER_ID=
# Package/Properties/PublisherDisplayName
MSIX__PUBLISHER_DISPLAY_NAME=

# The Windows SDK installed on this machine (C:\Program Files (x86)\Windows Kits\10\bin\<version>)
MSIX__WINDOWS_KIT_VERSION=10.0.28000.0

# ---- macOS: Mac App Store (`pnpm run make`) and website DMG (`pnpm run make:dmg`) ----
# developer.apple.com > Membership details > Team ID
MAS__TEAM_ID=
# The name in your certificate titles: "Apple Distribution: <name> (<team id>)",
# "Developer ID Application: <name> (<team id>)"
MAS__SIGNER_NAME=
# developer.apple.com > Identifiers (must match the provisioning profiles in mac-app-store/)
MAS__BUNDLE_ID=
# Optional CFBundleVersion, at most three numbers (e.g. 1.6.1): raise it to re-upload
# the same app version (defaults to package.json version)
MAS__BUILD_VERSION=

# App Store Connect > Users and Access > Integrations > App Store Connect API
# (`pnpm run upload:mas`; `make:dmg` notarizes with it). Put the key file at ~/.appstoreconnect/private_keys/AuthKey_<key id>.p8
ASC__API_KEY_ID=
ASC__API_ISSUER_ID=
