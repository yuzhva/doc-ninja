{
  "name": "nlp-ninja-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "purge:workspace--node_modules": "for /d /r . %d in (node_modules) do @if exist \"%d\" rmdir /s /q \"%d\"",
    "purge:workspace--dist": "for /d /r . %d in (dist) do @if exist \"%d\" rmdir /s /q \"%d\"",
    "purge": "pnpm run purge:workspace--node_modules && pnpm run purge:workspace--dist",
    "build:apps": "pnpm --filter \"./apps/**\" build",
    "dev:apps": "pnpm --filter \"./apps/**\" dev"
  },
  "devDependencies": {
    "@mainset/dev-stack-fe": "^0.2.0",
    "cross-env": "^10.1.0"
  }
}
